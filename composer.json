{
    "name": "roadrunner-php/symfony-lock-driver",
    "type": "library",
    "description": "RoadRunner: symfony/lock bridge",
    "keywords": [
        "roadrunner-php",
        "symfony",
        "roadrunner",
        "spiral",
        "lock"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Pavel Buchnev (butschster)",
            "email": "pavel.buchnev@spiralscout.com"
        },
        {
            "name": "Alexander Strizhak",
            "email": "gam6itko@gmail.com"
        }
    ],
    "homepage": "https://roadrunner.dev",
    "support": {
        "docs": "https://docs.roadrunner.dev",
        "issues": "https://github.com/roadrunner-server/roadrunner/issues",
        "forum": "https://forum.roadrunner.dev/",
        "chat": "https://discord.gg/V6EK4he"
    },
    "require": {
        "php": ">=8.2",
        "roadrunner-php/lock": "^1.0",
        "symfony/lock": "^6.0 || ^7.0 || ^8.0",
        "symfony/polyfill-php83": "^1.32"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "spiral/code-style": "^2.3.1",
        "testo/bridge-mockery": "^0.1.2",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "autoload": {
        "psr-4": {
            "Spiral\\RoadRunner\\Symfony\\Lock\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiral\\RoadRunner\\Symfony\\Lock\\Tests\\": "tests"
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/roadrunner-server"
        }
    ],
    "scripts": {
        "analyze": "psalm",
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "test": "testo"
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "GHSA-g9pc-8g42-g6vq": "False positive: the range < 2025.1.0 also matches RoadRunner 3.x, which is not affected"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "1.0-dev"
        }
    }
}
